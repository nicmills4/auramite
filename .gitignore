# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# audit scanner output + generated artifacts (may contain third-party site content)
/reports
/customers
/data

# keep the example env file (real .env* stay ignored via the rule above)
!.env.example

# outreach kit contains real contact PII — never commit
/outreach-sheet.md

/src/generated/prisma

# Prisma generated client (regenerated on install via postinstall)
/src/generated

# Editor/agent tooling: vendored skill docs and lockfiles, not project code.
# .claude/launch.json IS committed — it tells the dev-server tooling how to run.
/.agents
/.windsurf
/.claude/skills
/skills-lock.json
