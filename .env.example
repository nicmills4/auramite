# Copy to .env.local (dev) or set in Railway (prod). All optional until that feature is wired.

# Public base URL of the deployed site (used in emails/links)
NEXT_PUBLIC_BASE_URL=https://auramite.io

# Stripe (subscriptions) — wire when taking payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Postgres (Railway plugin) — for users/sites/scans/subscriptions
DATABASE_URL=

# Transactional email for reports (Resend or Postmark) — opted-in only, not cold
RESEND_API_KEY=

# Optional: real US/CA traffic enrichment (dashboard-only plans lack API access)
SIMILARWEB_API_KEY=
