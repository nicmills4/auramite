# Copy to .env.local (dev) or set in Railway (prod). All optional until that feature is wired.

# Public base URL of the deployed site (used in emails/links)
NEXT_PUBLIC_BASE_URL=https://auramite.io

# Stripe (subscriptions).
# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...): this app only needs
# write on Customers, Checkout Sessions and Billing Portal Sessions, plus read on
# Subscriptions and Prices. A leaked restricted key then can't move money.
# One Product per tier — Checkout shows the Product name on the line item, so
# three tiers sharing one Product are indistinguishable to the customer.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Postgres (Railway plugin) — for users/sites/scans/subscriptions
DATABASE_URL=

# Auth.js — magic-link sign-in. AUTH_SECRET: generate with `npx auth secret`.
AUTH_SECRET=
AUTH_URL=https://auramite.io           # dev: http://localhost:3000
AUTH_FROM_EMAIL=Auramite <login@auramite.io>   # must be on a Resend-verified domain

# Email (Resend) — lead notifications + auto-replies
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=            # where you get notified of new leads/consults (your inbox)
LEAD_FROM_EMAIL=Auramite <onboarding@resend.dev>   # switch to a verified @auramite.io sender after domain verify

# Scheduled monitoring runs (cli/run-scheduled.mjs) — these run on your machine/cron
OPERATOR_EMAIL=               # run summaries; overrides whitelist.json operatorEmail
REPORT_FROM_EMAIL=Auramite <reports@auramite.io>   # sender for customer monitoring reports
DRY_RUN=                      # set to 1 to write reports to data/outbox/ instead of emailing

# Optional: real US/CA traffic enrichment (dashboard-only plans lack API access)
SIMILARWEB_API_KEY=
